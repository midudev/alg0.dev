{
  "name": "alg0.dev",
  "type": "module",
  "version": "0.0.2",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && node scripts/deploy.mjs",
    "astro": "astro",
    "prepare": "husky",
    "og:generate": "node scripts/generate-og.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "format": "prettier . --write",
    "lint": "eslint . --fix"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.12.0",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-promise": "7.3.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "shiki": "4.5.0",
    "subset-font": "^2.9.0",
    "wrangler": "^4.156.2"
  }
}
