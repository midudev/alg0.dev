# Cloudflare Workers static assets — parsed at deploy time, never served.
# https://developers.cloudflare.com/workers/static-assets/headers/
# `scripts/cloudflare-routing.mjs` appends the HTML `Link` preloads (Early Hints) at build time
# and writes `_redirects` (301 `/slug` → `/slug/`).

/*
  Strict-Transport-Security: max-age=63072000

# Hashed by Vite (JS, CSS, fonts): safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Build-time sprites, referenced with a `?v=<content hash>` query.
/icons/*
  Cache-Control: public, max-age=31536000, immutable

# Stable names, regenerated by `pnpm og:generate`.
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# SPA fragments fetched by the client: never index them (robots.txt also disallows crawling).
/algorithm-content/*
  X-Robots-Tag: noindex

/algorithm-code/*
  X-Robots-Tag: noindex

# Keep workers.dev and preview URLs out of search results.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
