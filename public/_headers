# Cloudflare Workers static assets — parsed at deploy time, never served.
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  Strict-Transport-Security: max-age=63072000

# Hashed by Vite: safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable names (regenerated by `pnpm fonts:subset` / `pnpm og:generate`).
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Keep workers.dev and preview URLs out of search results.
https://:worker.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
